
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/loadingScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/loadingLogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:maxWidth="360dp"
            android:maxHeight="160dp"
            android:scaleType="fitCenter"
            android:src="@drawable/dailycart_loading_logo"
            android:contentDescription="DailyCart logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Freshness at your doorstep."
            android:textColor="#064E3B"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="145dp"
            android:layout_height="4dp"
            android:layout_marginTop="42dp"
            android:indeterminate="true"
            android:indeterminateTint="#16A34A"
            android:progressTint="#16A34A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="PREPARING YOUR EXPERIENCE"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

    </LinearLayout>

</FrameLayout>
